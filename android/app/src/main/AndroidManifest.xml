<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Scanning the QR code of another device or an invitation. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Devices on the same Wi-Fi find each other through UDP broadcast;
         Android drops those packets unless the app holds a multicast lock. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <application
        android:allowBackup="true"
        android:label="${istmoLabel}"
        android:icon="${istmoIcon}"
        android:hasCode="true"
        android:localeConfig="@xml/locales_config"
        android:theme="@style/Theme.AppCompat.NoActionBar">
        <!-- GameActivity (androidx.games:games-activity) so
             `dispatchTouchEvent` runs on the Java side — the Kotlin
             `NotinplusActivity` intercepts stylus samples and forwards
             them into `PenCaptureView` before delegating to super for
             winit / freya (via `android_main`). `NativeActivity` was
             unusable because it takes the raw `InputQueue`, bypassing
             the view hierarchy.

             `configChanges` lists every change the window can go through
             (split screen, resizing, rotation, density, theme): the Rust
             side runs once per process and cannot come back on a
             recreated activity, so winit takes them as resizes instead. -->
        <activity
            android:name="rs.sergioribera.notinplus.NotinplusActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboard|keyboardHidden|navigation|uiMode|fontScale|locale|layoutDirection">
            <meta-data
                android:name="android.app.lib_name"
                android:value="notinplus" />
            <intent-filter>
                <action   android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Pairing and invitation links (`notein://pair`, `notein://join`)
                 scanned from another device's QR code open the app here. -->
            <intent-filter>
                <action   android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="notein" />
            </intent-filter>
            <!-- Documents the system opens with the app ([[app.document_type]]
                 in istmo.toml), managed by istmo-build. -->
            <!-- istmo:documents:start -->
<intent-filter>
    <action android:name="android.intent.action.VIEW"/>
    <category android:name="android.intent.category.DEFAULT"/>
    <data android:scheme="content"/>
    <data android:scheme="file"/>
    <data android:mimeType="application/pdf"/>
    <data android:mimeType="application/x-notin"/>
    <data android:mimeType="application/x-notinplus-plugin"/>
    <data android:mimeType="text/markdown"/>
    <data android:mimeType="text/plain"/>
    <data android:mimeType="text/x-markdown"/>
</intent-filter>
<intent-filter>
    <action android:name="android.intent.action.SEND"/>
    <category android:name="android.intent.category.DEFAULT"/>
    <data android:mimeType="application/pdf"/>
    <data android:mimeType="application/x-notin"/>
    <data android:mimeType="application/x-notinplus-plugin"/>
    <data android:mimeType="text/markdown"/>
    <data android:mimeType="text/plain"/>
    <data android:mimeType="text/x-markdown"/>
</intent-filter>
<intent-filter>
    <action android:name="android.intent.action.VIEW"/>
    <category android:name="android.intent.category.DEFAULT"/>
    <data android:scheme="content"/>
    <data android:scheme="file"/>
    <data android:host="*"/>
    <data android:mimeType="*/*"/>
    <data android:pathPattern=".*\\.notin"/>
    <data android:pathPattern=".*\\..*\\.notin"/>
    <data android:pathPattern=".*\\..*\\..*\\.notin"/>
    <data android:pathPattern=".*\\..*\\..*\\..*\\.notin"/>
    <data android:pathPattern=".*\\.ntp"/>
    <data android:pathPattern=".*\\..*\\.ntp"/>
    <data android:pathPattern=".*\\..*\\..*\\.ntp"/>
    <data android:pathPattern=".*\\..*\\..*\\..*\\.ntp"/>
</intent-filter>
<!-- istmo:documents:end -->
        </activity>
    </application>
</manifest>
