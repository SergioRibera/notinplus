<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Devices on the same Wi-Fi find each other through UDP broadcast;
         Android drops those packets unless the app holds a multicast lock. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <application
        android:allowBackup="true"
        android:label="${istmoLabel}"
        android:icon="${istmoIcon}"
        android:hasCode="true"
        android:theme="@style/Theme.AppCompat.NoActionBar">
        <!-- GameActivity (androidx.games:games-activity) so
             `dispatchTouchEvent` runs on the Java side — the Kotlin
             `NotinplusActivity` intercepts stylus samples and forwards
             them into `PenCaptureView` before delegating to super for
             winit / freya (via `android_main`). `NativeActivity` was
             unusable because it takes the raw `InputQueue`, bypassing
             the view hierarchy. -->
        <activity
            android:name="rs.sergioribera.notinplus.NotinplusActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|keyboardHidden|screenSize">
            <meta-data
                android:name="android.app.lib_name"
                android:value="notinplus" />
            <intent-filter>
                <action   android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Pairing and invitation links (`notein://pair`, `notein://join`)
                 scanned from another device's QR code open the app here. -->
            <intent-filter>
                <action   android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="notein" />
            </intent-filter>
        </activity>
    </application>
</manifest>
