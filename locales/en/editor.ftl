## NotIn Plus's additions to the editor (src/editor.rs, src/editor/).

editor-suggest-references = References
# $source: where the quote comes from, e.g. "Genesis 1:3 · Bible".
editor-quote-live = { $source } · live block
editor-quote-copy = { $source } · fixed copy
editor-quote-gone = { $source } · no longer exists
# $source: where the pictures come from, e.g. "PDF document".
editor-snapshot-copy = { $source } · pictures, fixed copy
editor-snapshot-gone = That document no longer exists
editor-snapshot-empty = Nothing to picture there yet
editor-snapshot-on-canvas = Added to the canvas
editor-image-pick-title = Image
editor-image-failed = Couldn't load the image
