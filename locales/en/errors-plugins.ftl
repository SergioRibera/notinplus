## Why installing or loading a plugin failed.

# $reason is a sentence explaining the underlying failure.
errors-plugin-copy = Couldn't copy the plugin. { $reason }
errors-plugin-not-a-package = This file isn't a Notein plugin package, or it's damaged.
# $manifest is the manifest file name.
errors-plugin-no-manifest = The package doesn't include { $manifest }.
# $reason is a sentence explaining the underlying failure.
errors-plugin-bible-unavailable = Couldn't open the translations database. { $reason }
