## Shared components: themes, controls and sheet chrome

kit-theme-night = Night
kit-theme-day = Day
kit-theme-sepia = Sepia
kit-theme-high-contrast = High contrast
kit-theme-oled = OLED

kit-switch-on = On
kit-switch-off = Off

# $max is the field's character limit
kit-field-max-length = { $max ->
    [one] At most 1 character
   *[other] At most { $max } characters
}
kit-search-clear = Clear search

kit-tag-remove = Remove

# $count is how many people do not fit in the avatar stack
kit-avatar-more = { $count ->
    [one] Show 1 more person
   *[other] Show { $count } more people
}

kit-stepper-decrease = Decrease
kit-stepper-increase = Increase

kit-sheet-back = Back
kit-sheet-close = Close

kit-color-hex = Hex
