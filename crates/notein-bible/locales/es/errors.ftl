## Bible storage, download and import failures shown to users.

errors-db-damaged = La base de traducciones está dañada. Reinstalar la traducción puede arreglarlo.
errors-db-other = Algo salió mal con la base de traducciones. Inténtalo de nuevo.
# $id is the translation's id.
errors-db-missing-bible = La traducción { $id } no está instalada.
