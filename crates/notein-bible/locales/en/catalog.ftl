## Translation downloads: the catalog sheet, the first-use card and their toasts (src/ui/catalog.rs, src/installer.rs).

# $name is the translation's short name, e.g. KJV.
catalog-toast-installed = “{ $name }” is ready to read
# $reason is the technical cause the download reported.
catalog-toast-failed = Couldn't download “{ $name }”: { $reason }
catalog-retry = Retry
catalog-step-preparing = Preparing the download…
catalog-step-books = Books: { $done } of { $total }
catalog-step-cross-refs = Cross-references: { $done } of { $total } books
catalog-step-headings-preparing = Section headings…
catalog-step-headings = Headings: { $done } of { $total } books
catalog-unavailable = The Bible isn't available on this device.
catalog-title = Bible translations
catalog-subtitle = They download one at a time; you can close this and they keep going.
catalog-load-failed = Couldn't load the catalog
catalog-filter-all = All
catalog-search-placeholder = Search by name or language
catalog-no-matches = No translations match that name.
catalog-truncated = Showing { $shown } of { $total }. Search by name or language to find the rest.
catalog-queued = Queued
catalog-installed = Installed
catalog-install = Install
# $step is a download progress line such as “Books: 3 of 66”.
catalog-first-use-step = { $step } · Opens when done
catalog-first-use-queued = Queued…
catalog-download-failed = Couldn't download
catalog-first-use-download = Download { $name } and open
catalog-offline = No connection to the catalog
catalog-first-use-title = Choose a translation to get started
catalog-first-use-body = It downloads once and stays on this device. After that you can read offline.
catalog-first-use-browse = See all translations

installer-could-not-start = Couldn't start the download
installer-download-failed = The download failed
