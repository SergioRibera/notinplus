## El tipo de documento Biblia: entradas de creación, nombres y etiquetas que muestra la app (src/kind.rs).

kind-default-name = Biblia
# $abbrev es el nombre corto de la traducción, p. ej. RVR1960.
kind-default-name-of = Biblia { $abbrev }
kind-label = Biblia
kind-plural = Biblia
kind-search-group = En la Biblia
# $name es el nombre de la traducción.
kind-meta-highlights = { $count ->
    [one] { $name } · 1 resaltado
   *[other] { $name } · { $count } resaltados
}
kind-action-change-translation = Cambiar traducción
kind-entry-label = Biblia
kind-entry-subtitle = Leer y resaltar
kind-sheet-title = Nueva Biblia
kind-sheet-name-hint = Ej.: Biblia de estudio
kind-choose-title = Abrir Biblia
kind-choose-add-translation = Agregar traducción
kind-choice-label = Traducción
