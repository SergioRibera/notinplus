## Citas del texto original: una palabra en su versículo, un término del diccionario o versículos palabra por palabra (src/kind/original.rs).

cite-option-pronunciation = Pronunciación
cite-option-grammar = Gramática
cite-option-here = Significado aquí
cite-option-also = Otros significados
cite-option-senses = Sentidos del diccionario
cite-option-renderings = Cómo lo traduce tu Biblia
cite-option-occurrences = Dónde aparece
cite-option-family = Familia de palabras
cite-option-reading = Pronunciación de cada palabra
cite-option-gloss = Significado de cada palabra
cite-option-translation = Versículo en tu Biblia
# $word: la palabra en el original; $place: el versículo.
cite-word-chip = { $word } ({ $place })
# $language: «griego» o «hebreo».
cite-original-chip = { $place } en { $language }
cite-word-source = { $place }, { $language }
cite-term-source = { $lemma }, diccionario de { $language }. STEPBible (CC BY 4.0)
cite-interlinear-source = { $place }, { $language }. STEPBible (CC BY 4.0)
cite-from-lemma = de { $lemma }
cite-heading-also = También
cite-renders-in = Cómo lo traduce { $bible }
cite-family = Familia
cite-language-greek = griego
cite-language-hebrew = hebreo
# Palabras que, tras un pasaje («Mt 5:3 griego»), piden el texto original; separadas por comas.
cite-search-keywords = original,griego,hebreo,greek,hebrew
cite-term-hit = { $lemma } ({ $translit })
cite-term-hit-snippet = Diccionario: { $gloss }. { $count ->
    [one] 1 vez
   *[other] { $count } veces
}
cite-interlinear-snippet = Palabra por palabra: original, pronunciación y significado
