<?xml version="1.0" encoding="utf-8"?>
<!--
  istmo.installer — merged into every variant's manifest by the istmo
  Gradle plugin `io.github.sergioribera.istmo`. Only adds a permission
  and a provider; it never overrides the app's own settings.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Lets the app open the package installer. Android still asks
         the user to allow it once, per app. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application>
        <!-- content:// URIs for the APKs handed to the installer.
             Authority must match InstallerBackendImpl.AUTHORITY_SUFFIX. -->
        <provider
            android:name="dev.istmo.plugins.installer.IstmoInstallerFileProvider"
            android:authorities="${applicationId}.istmo.installer.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/istmo_installer_paths" />
        </provider>
    </application>
</manifest>
